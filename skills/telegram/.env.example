# tg-skill config. Copy to .env next to SKILL.md (or export the same variables).
# Never commit .env. See "Security model" in the README before putting it anywhere hosted.

# --- Account (Telethon). Full access to your Telegram: read the README first. ---
# https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_PHONE=+79001234567
# Printed by `python3 scripts/tg.py login`. Without it a .sessions/user file is used,
# which does not survive a throwaway chat sandbox.
TELEGRAM_SESSION_STRING=

# --- Bot (Bot API). Scoped to one bot, revocable in @BotFather. ---
# Token from @BotFather; your numeric id from @userinfobot.
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_USER_ID=123456789

# --- Optional ---
# Writes (send, bot to others) only to these chats: @usernames or ids from `tg.py chats`.
# TG_ALLOWED_CHATS=@alice,-1001234567890
# Proxy for the account connection (needs `pip install python-socks`).
# TG_PROXY=socks5://127.0.0.1:1080
